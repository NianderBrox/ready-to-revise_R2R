# Root .env — shared defaults for docker compose (copy to .env and edit)
# Per-service examples: backend/.env.example, machine_learning/.env.example

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

JWT_SECRET=change-me-dev-secret

GEMINI_API_KEY=

ML_PORT=8000

# CORS - comma-separated allowed origins, or * for all
CORS_ORIGIN=*

# Storage driver: local (filesystem) or s3 (S3-compatible: Tigris / Cloudflare R2 / Backblaze B2)
STORAGE_DRIVER=local

# S3-compatible object storage settings (only used when STORAGE_DRIVER=s3)
# Tigris example: S3_ENDPOINT=https://t3.storage.dev, S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=
