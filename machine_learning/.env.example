# --- ML inference API (connection settings) ---
ML_HOST=127.0.0.1
ML_PORT=8000
ML_MODEL_NAME=calibrated_best

# --- Shared Postgres (TRAINING ONLY; inference never touches the DB) ---
# docker-compose maps r2r-postgres to HOST port 5433; inside the compose
# network the container port is 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=r2r_db
DB_USER=ml_readonly
DB_PASSWORD=
# Schema the training pipeline reads unqualified tables from. The backend
# exposes read-only ML views in the `ml` schema (see the backend migration
# `create_ml_schema_views`). Use `public` for the local sandbox (schema.sql).
DB_SCHEMA=ml
