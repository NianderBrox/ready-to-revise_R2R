# --- ML inference API (connection settings) ---
ML_HOST=127.0.0.1
ML_PORT=8000
MODEL_NAME=gradient_boosting

# --- Shared Postgres (TRAINING ONLY; inference never touches the DB) ---
# docker-compose maps r2r-postgres to HOST port 5433; inside the compose
# network the container port is 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=r2r_db
DB_USER=ml_readonly
DB_PASSWORD=
