PORT=3000
NODE_ENV=development

# CORS - comma-separated list of allowed origins, or * to allow all
CORS_ORIGIN=*

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Hosted Postgres connection string (e.g. Supabase or Neon free tier).
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Local file uploads directory (only used when STORAGE_DRIVER=local)
UPLOAD_DIRECTORY=uploads

# Storage driver: local (filesystem) or s3 (S3-compatible: Tigris / Cloudflare R2 / Backblaze B2)
STORAGE_DRIVER=local

# S3-compatible object storage settings (only used when STORAGE_DRIVER=s3)
# Tigris example: S3_ENDPOINT=https://t3.storage.dev, S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=

# ML service
ML_SERVICE_URL=http://localhost:8000
ML_MODEL_NAME=gradient_boosting
ML_TIMEOUT_MS=2000
ML_FAILURE_COOLDOWN_MS=30000

# Recommendation tuning
RECOMMENDATION_TARGET_RETENTION=0.9
RECOMMENDATION_SLIDING_WINDOW_HOURS=48
RECOMMENDATION_REFRACTORY_HOURS=20
RECOMMENDATION_DAILY_CAP=20